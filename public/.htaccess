# Configuração para hospedagem Apache/LiteSpeed (ex.: Hostinger)
# Sem estas regras, qualquer página interna acessada diretamente
# (ex.: /servicos/pgrs) retorna erro 404 para o visitante e para o Google.

Options -MultiViews
RewriteEngine On

# Força HTTPS e domínio sem "www" (uma única versão do site para o Google)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://icsambiental.com.br%{REQUEST_URI} [L,R=301]

# Remove barra final (/servicos/ -> /servicos)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]

# Entrega arquivos e pastas que existem; o resto vai para o app React
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ /index.html [L]

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# Cache longo para arquivos com hash no nome (pasta /assets gerada pelo Vite)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
